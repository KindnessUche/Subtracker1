# Copy this file to .env and adjust as needed.
# Sensible defaults are baked into docker-compose.yml, so the app runs
# out of the box even if you never create a .env file at all.

# ---- Database ----
POSTGRES_DB=subtracker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# ---- Ports ----
BACKEND_PORT=8080
FRONTEND_PORT=3000

# ---- Backend URLs (used for CORS + OAuth redirects) ----
APP_FRONTEND_URL=http://localhost:3000
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080

# ---- Security (CHANGE THESE FOR ANY REAL DEPLOYMENT) ----
JWT_SECRET=please_change_this_secret_in_production
# Must be a base64-encoded 32-byte key, e.g. generate with:
#   openssl rand -base64 32
APP_ENCRYPTION_KEY=

# ---- Optional: Gmail auto-import feature ----
# Leave blank to disable Gmail sync; manual subscription tracking still works fine.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/gmail/callback

# ---- Optional: Gemini extraction (used by Gmail sync) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GMAIL_SYNC_MAX_RESULTS=50
GMAIL_SYNC_WINDOW_DAYS=400

# development (default) = local http testing, insecure-secret guard is off, cookie sent over http.
# production = deploy behind https, and StartupSecurityGuard will refuse to boot with default secrets.
APP_ENV=development
# Cookie holding the JWT. Keep false for local http testing; set true once served over https.
COOKIE_SECURE=false

# ---- Optional: renewal-reminder emails ----
# Leave MAIL_ENABLED=false to keep the app running without SMTP creds; nothing gets sent.
MAIL_ENABLED=false
MAIL_FROM=no-reply@subtracker.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# How many days before a subscription renews to send the reminder email.
REMINDER_DAYS_BEFORE=3
